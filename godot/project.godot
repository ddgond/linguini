; Engine configuration file.

config_version=5

[application]

config/name="Linguini"
config/description="A Moonlight client where you are the fish."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

InputSetup="*res://scripts/input_setup.gd"
Settings="*res://scripts/settings.gd"
Quality="*res://scripts/quality.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=120

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[shader_globals]

tank_water_min={
"type": "vec3",
"value": Vector3(-0.6, 0.83, -0.25)
}
tank_water_max={
"type": "vec3",
"value": Vector3(0.6, 1.36, 0.25)
}
caustics_strength={
"type": "float",
"value": 1.0
}
fish_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
